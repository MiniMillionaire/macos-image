{
  "width": 2048,
  "height": 1536,
  "actions": [
    { "chord": ["command", "a"] },
    { "text": "${GUEST_PASSWORD}" },
    { "key": "enter" },
    { "wait": "30s" },
    { "chord": ["command", "space"] },
    { "wait": "3s" },
    { "text": "Terminal" },
    { "key": "enter" },
    { "wait": "10s" },
    { "text": "defaults write NSGlobalDomain AppleKeyboardUIMode -int 3" },
    { "key": "enter" },
    { "wait": "5s" },
    { "text": "open 'x-apple.systempreferences:com.apple.Sharing-Settings.extension'" },
    { "key": "enter" },
    { "wait": "20s" },
    { "key": "tab", "repeat": 17 },
    { "key": "space" },
    { "wait": "3s" },
    { "text": "${GUEST_PASSWORD}" },
    { "key": "enter" },
    { "wait": "20s" },
    { "chord": ["command", "q"] },
    { "wait": "5s" }
  ]
}
