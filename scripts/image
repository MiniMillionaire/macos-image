#!/usr/bin/env bash
set -euo pipefail
export TART_NO_AUTO_PRUNE=1
export GOPROXY=off
export GOSUMDB=off
export GOTOOLCHAIN=local

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
config_path=${IMAGE_CONFIG:-config/sequoia-15.6.1.env}
export PACKER_CONFIG="$root_dir/config/packer.json"
[[ -f "$PACKER_CONFIG" ]] || { echo "Packer configuration not found: $PACKER_CONFIG" >&2; exit 1; }

source "$root_dir/config/toolchain.env"

if [[ "$config_path" != /* ]]; then
  config_path="$root_dir/$config_path"
fi

[[ -f "$config_path" ]] || { echo "Configuration not found: $config_path" >&2; exit 1; }
source "$config_path"

: "${MACOS_FAMILY:?}"
: "${MACOS_VERSION:?}"
: "${MACOS_BUILD:?}"
: "${IMAGE_PRERELEASE:?}"
if [[ -n ${VANILLA_SOURCE_PROFILE:-} ]]; then
  : "${VANILLA_SOURCE_DIGEST:?}"
  : "${INSTALLER_URL:?}"
  : "${INSTALLER_SIZE:?}"
  : "${INSTALLER_SHA256:?}"
else
  : "${IPSW_URL:?}"
  : "${IPSW_SIZE:?}"
  : "${IPSW_SHA256:?}"
fi
: "${VANILLA_TEMPLATE:?}"
: "${DISABLE_SIP_TEMPLATE:?}"
: "${LOCAL_VANILLA_SOURCE:?}"
: "${VANILLA_VM:?}"
: "${BASE_VM:?}"
: "${CPU_COUNT:?}"
: "${MEMORY_GB:?}"
: "${MINIMUM_HOST_MAJOR:?}"

registry=${REGISTRY:-}
registry=${registry%/}
xcode_cache=${XCODE_CACHE:-$HOME/XcodesCache}
guest_username=${GUEST_USERNAME:-admin}
guest_password=${GUEST_PASSWORD:-admin}
artifact_helper=${ARTIFACT_HELPER:-$root_dir/.build/tools/image-artifact}
registry_helper=${REGISTRY_HELPER:-$root_dir/scripts/registry}
image_cacert=${IMAGE_CACERT:-/opt/homebrew/etc/openssl@3/cert.pem}
ipsw_cache_dir=${IPSW_CACHE_DIR:-${TART_HOME:-$HOME/.tart}/cache/macos-image/ipsw}
ipsw_path_override=${IPSW_PATH:-}
installer_cache_dir=${INSTALLER_CACHE_DIR:-$HOME/.cache/macos-image/installers}
build_disk_size_gb=256
disk_growth_max_steps=8
disk_size_tolerance_bytes=$((1024 * 1024))
published_free_bytes=$((8 * 1024 * 1024 * 1024))
published_disk_step_gb=10
packer_check_timeout_seconds=${PACKER_CHECK_TIMEOUT_SECONDS:-600}
packer_build_timeout_seconds=${PACKER_BUILD_TIMEOUT_SECONDS:-14400}
ipsw_fetch_timeout_seconds=${IPSW_FETCH_TIMEOUT_SECONDS:-14400}
tart_create_timeout_seconds=${TART_CREATE_TIMEOUT_SECONDS:-14400}
tart_clone_timeout_seconds=${TART_CLONE_TIMEOUT_SECONDS:-3600}
tart_operation_timeout_seconds=${TART_OPERATION_TIMEOUT_SECONDS:-600}
setup_assistant_timeout_seconds=${SETUP_ASSISTANT_TIMEOUT_SECONDS:-2100}
registry_timeout_seconds=${REGISTRY_TIMEOUT_SECONDS:-14400}
create_grace_time=${CREATE_GRACE_TIME:-${DEFAULT_CREATE_GRACE_TIME:-30s}}
setup_assistant_initial_wait=${SETUP_ASSISTANT_INITIAL_WAIT:-${DEFAULT_SETUP_ASSISTANT_INITIAL_WAIT:-90s}}
setup_assistant_resume_wait=${SETUP_ASSISTANT_RESUME_WAIT:-${DEFAULT_SETUP_ASSISTANT_RESUME_WAIT:-45s}}
setup_assistant_user_wait=${SETUP_ASSISTANT_USER_WAIT:-${DEFAULT_SETUP_ASSISTANT_USER_WAIT:-90s}}
setup_assistant_final_wait=${SETUP_ASSISTANT_FINAL_WAIT:-${DEFAULT_SETUP_ASSISTANT_FINAL_WAIT:-90s}}
setup_assistant_gatekeeper_wait=${SETUP_ASSISTANT_GATEKEEPER_WAIT:-${DEFAULT_SETUP_ASSISTANT_GATEKEEPER_WAIT:-90s}}
setup_assistant_key_interval=${SETUP_ASSISTANT_KEY_INTERVAL:-50ms}
setup_assistant_upgrade_wait=${SETUP_ASSISTANT_UPGRADE_WAIT:-60s}
setup_assistant_upgrade_key_interval=${SETUP_ASSISTANT_UPGRADE_KEY_INTERVAL:-150ms}
temporary_locale_home=
active_pid=
verification_vm=
packer_plugin_checked=false
temporary_root=${TMPDIR:-/tmp}
temporary_root=${temporary_root%/}
[[ -n "$temporary_root" ]] || temporary_root=/

cleanup_locale_home() {
  [[ -n "$temporary_locale_home" ]] || return 0
  [[ "$temporary_locale_home" == "$temporary_root"/macos-image-locale.* ]] || return 1
  rm -rf -- "$temporary_locale_home"
}

cleanup() {
  local exit_code=$?
  local cleanup_status=0
  local vm=$verification_vm
  trap - EXIT
  verification_vm=
  set +e
  if [[ -n "$vm" ]]; then
    echo "Deleting verification VM after interruption: $vm" >&2
    delete_test_vm "$vm"
    cleanup_status=$?
  fi
  cleanup_locale_home || cleanup_status=$?
  if (( exit_code == 0 && cleanup_status != 0 )); then
    exit_code=$cleanup_status
  fi
  exit "$exit_code"
}

trap cleanup EXIT

forward_signal() {
  local signal=$1
  [[ -n "$active_pid" ]] || return 0
  kill -s "$signal" "$active_pid" 2>/dev/null || true
}

trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM

die() {
  echo "$*" >&2
  exit 1
}

is_numeric_version() {
  [[ "$1" =~ ^(0|[1-9][0-9]*)([.](0|[1-9][0-9]*)){0,2}$ ]]
}

is_xcode_tag() {
  (( ${#1} <= 128 )) &&
    [[ "$1" =~ ^(0|[1-9][0-9]*)([.](0|[1-9][0-9]*)){0,2}(-[a-z0-9]+([.-][a-z0-9]+)*)?$ ]]
}

versions_match() {
  awk -v left="$1" -v right="$2" 'BEGIN {
    split(left, l, ".")
    split(right, r, ".")
    for (i = 1; i <= 3; i++) {
      if ((l[i] + 0) != (r[i] + 0)) exit 1
    }
    exit 0
  }'
}

validate_configuration() {
  [[ "$IMAGE_PRERELEASE" == true || "$IMAGE_PRERELEASE" == false ]] ||
    die "Invalid prerelease value: $IMAGE_PRERELEASE"
  if [[ -n ${VANILLA_SOURCE_PROFILE:-} ]]; then
    [[ "$VANILLA_SOURCE_PROFILE" =~ ^[a-z0-9][a-z0-9.-]*$ ]] || die 'Invalid source profile'
    [[ "$VANILLA_SOURCE_DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]] || die 'Invalid source digest'
    [[ "$INSTALLER_URL" == https://swcdn.apple.com/* ]] || die 'Invalid installer URL'
    [[ "$INSTALLER_SIZE" =~ ^[1-9][0-9]*$ ]] || die 'Invalid installer size'
    [[ "$INSTALLER_SHA256" =~ ^[0-9a-f]{64}$ ]] || die 'Invalid installer SHA-256'
  else
    [[ "$IPSW_SIZE" =~ ^[1-9][0-9]*$ ]] || die "Invalid IPSW size: $IPSW_SIZE"
    [[ "$IPSW_SHA256" =~ ^[0-9a-f]{64}$ ]] || die "Invalid IPSW SHA-256: $IPSW_SHA256"
  fi
  if [[ -n ${POST_UPGRADE_SETUP_SEQUENCE:-} || -n ${POST_UPGRADE_SETUP_CHECK:-} ]]; then
    [[ -n ${POST_UPGRADE_SETUP_SEQUENCE:-} && -n ${POST_UPGRADE_SETUP_CHECK:-} ]] ||
      die 'Post-upgrade setup requires both a sequence and native checks'
    [[ -f "$root_dir/$POST_UPGRADE_SETUP_SEQUENCE" && ! -L "$root_dir/$POST_UPGRADE_SETUP_SEQUENCE" ]] ||
      die "Post-upgrade Setup Assistant sequence not found: $POST_UPGRADE_SETUP_SEQUENCE"
    [[ -f "$root_dir/$POST_UPGRADE_SETUP_CHECK" && ! -L "$root_dir/$POST_UPGRADE_SETUP_CHECK" ]] ||
      die "Post-upgrade setup checks not found: $POST_UPGRADE_SETUP_CHECK"
  fi
}

need() {
  command -v "$1" >/dev/null || die "Missing required command: $1"
}

ensure_artifact_helper() {
  if [[ ! -x "$artifact_helper" ]]; then
    need go
    mkdir -p "$(dirname "$artifact_helper")"
    go build -trimpath -o "$artifact_helper" ./cmd/image-artifact
  fi
}

run_bounded() {
  local timeout_seconds=$1
  local child_pid
  local status
  shift
  [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || die "Invalid timeout: $timeout_seconds"
  ensure_artifact_helper
  "$artifact_helper" run --timeout "$timeout_seconds" -- "$@" &
  active_pid=$!
  child_pid=$active_pid
  while true; do
    if wait "$child_pid"; then
      status=0
    else
      status=$?
    fi
    kill -0 "$child_pid" 2>/dev/null || break
  done
  active_pid=
  return "$status"
}

capture_bounded() {
  local timeout_seconds=$1
  local output_file
  local status
  shift
  output_file=$(mktemp "$temporary_root/macos-image-command.XXXXXX")
  if run_bounded "$timeout_seconds" "$@" > "$output_file" 2>&1; then
    status=0
  else
    status=$?
  fi
  bounded_output=$(<"$output_file")
  rm -f -- "$output_file"
  return "$status"
}

version_is_at_least() {
  awk -v actual="$1" -v minimum="$2" 'BEGIN {
    split(actual, a, ".")
    split(minimum, m, ".")
    for (i = 1; i <= 3; i++) {
      av = a[i] + 0
      mv = m[i] + 0
      if (av > mv) exit 0
      if (av < mv) exit 1
    }
    exit 0
  }'
}

check_tool_version() {
  local name=$1
  local actual=$2
  local pinned=$3
  local minimum=$4
  local strict=$5
  [[ "$actual" =~ ^[0-9]+([.][0-9]+){1,2}$ ]] || die "Could not parse $name version: $actual"
  if [[ "$strict" == true ]]; then
    [[ "$actual" == "$pinned" ]] || die "$name $pinned is required in CI; found $actual"
  else
    version_is_at_least "$actual" "$minimum" || die "$name $minimum or newer is required; found $actual"
  fi
}

verify_plugin_pin() {
  local template
  for template in "$root_dir"/templates/*.pkr.hcl; do
    grep -Fq "version = \"= $PACKER_TART_PLUGIN_VERSION\"" "$template" ||
      die "Tart Packer plugin $PACKER_TART_PLUGIN_VERSION must be pinned in $template"
  done
}

require_installed_packer_plugin() {
  local version_pattern=${PACKER_TART_PLUGIN_VERSION//./\\.}
  [[ "$packer_plugin_checked" == false ]] || return 0
  if ! capture_bounded 30 packer plugins installed; then
    printf '%s\n' "$bounded_output" >&2
    die 'Could not inspect installed Packer plugins'
  fi
  grep -F 'github.com/cirruslabs/tart' <<<"$bounded_output" |
    grep -E "(^|[^0-9.])v?$version_pattern([^0-9.]|$)" >/dev/null ||
    die "Tart Packer plugin $PACKER_TART_PLUGIN_VERSION is not installed"
  packer_plugin_checked=true
}

verify_toolchain() {
  local strict=$1
  local output
  need tart
  need packer
  need go
  need xcrun

  capture_bounded 30 tart --version || die 'Could not read the Tart version'
  output=$bounded_output
  actual_tart_version=$(awk 'NR == 1 { print $NF }' <<<"$output")
  actual_tart_version=${actual_tart_version##* }
  actual_tart_version=${actual_tart_version#v}
  capture_bounded 30 packer --version || die 'Could not read the Packer version'
  output=$bounded_output
  actual_packer_version=$(awk '$1 == "Packer" && $2 ~ /^v[0-9]/ { sub(/^v/, "", $2); print $2; exit }' <<<"$output")
  capture_bounded 30 go version || die 'Could not read the Go version'
  output=$bounded_output
  actual_go_version=$(awk '{ print $3 }' <<<"$output")
  actual_go_version=${actual_go_version#go}
  capture_bounded 30 xcrun swift --version || die 'Could not read the Swift version'
  output=$bounded_output
  actual_swift_version=$(sed -n '1s/.*[Vv]ersion[[:space:]]*\([0-9][0-9.]*\).*/\1/p' <<<"$output")

  check_tool_version Tart "$actual_tart_version" "$TART_VERSION" "$TART_MINIMUM_VERSION" "$strict"
  check_tool_version Packer "$actual_packer_version" "$PACKER_VERSION" "$PACKER_MINIMUM_VERSION" "$strict"
  check_tool_version Go "$actual_go_version" "$GO_VERSION" "$GO_MINIMUM_VERSION" "$strict"
  check_tool_version Swift "$actual_swift_version" "$SWIFT_VERSION" "$SWIFT_MINIMUM_VERSION" "$strict"
  verify_plugin_pin
  require_installed_packer_plugin
}

vm_exists() {
  tart get "$1" >/dev/null 2>&1
}

require_new_vm() {
  if vm_exists "$1"; then
    die "VM already exists: $1"
  fi
}

require_registry_push_credentials() {
  local reference=$1
  [[ -n ${TART_REGISTRY_USERNAME:-} && -n ${TART_REGISTRY_PASSWORD:-} ]] ||
    die 'Registry pushes require TART_REGISTRY_USERNAME and TART_REGISTRY_PASSWORD; host credential stores are never used'
  [[ -n ${TART_REGISTRY_HOSTNAME:-} ]] ||
    die 'Registry pushes require TART_REGISTRY_HOSTNAME'
  if [[ ${TART_REGISTRY_HOSTNAME:-} != "${reference%%/*}" ]]; then
    die 'TART_REGISTRY_HOSTNAME does not match the requested registry'
  fi
}

clone_vm() {
  local source=$1
  local target=$2
  local variant=$3
  require_new_vm "$target"
  if [[ "$source" == */* ]]; then
    registry_pull "$variant" "$source" "$target"
  else
    run_bounded "$tart_clone_timeout_seconds" tart clone "$source" "$target"
  fi
}

clear_stale_control_socket() {
  local vm=$1
  local state
  local socket
  [[ "$vm" =~ ^[A-Za-z0-9._:-]+$ ]] || die "Invalid VM name: $vm"
  state=$(tart get "$vm" | awk 'NR == 2 { print $NF }')
  [[ "$state" != running ]] || die "VM is running: $vm"
  socket="${TART_HOME:-$HOME/.tart}/vms/$vm/control.sock"
  if [[ -S "$socket" ]]; then
    unlink "$socket"
  fi
}

require_compatible_host() {
  local host_major
  host_major=$(sw_vers -productVersion | cut -d. -f1)
  (( host_major >= MINIMUM_HOST_MAJOR )) || die "macOS $MINIMUM_HOST_MAJOR or newer is required for this image"
}

require_build_host() {
  require_compatible_host
  need jq
  need plutil
  capture_bounded 30 diskutil image resize --help || die 'This host does not provide diskutil image resize'
}

require_duration() {
  [[ "$1" =~ ^([0-9]+([.][0-9]+)?(ns|us|µs|ms|s|m|h))+$ ]] || die "Invalid duration: $1"
}

require_ca_file() {
  [[ -f "$image_cacert" && -r "$image_cacert" ]] || die "CA certificate bundle not found: $image_cacert"
}

create_locale_home() {
  local preferences
  temporary_locale_home=$(mktemp -d "$temporary_root/macos-image-locale.XXXXXX")
  preferences="$temporary_locale_home/Library/Preferences/.GlobalPreferences.plist"
  mkdir -p "$(dirname "$preferences")"
  plutil -create xml1 "$preferences"
  plutil -insert AppleLocale -string en_US "$preferences"
  plutil -insert AppleLanguages -json '["en-US"]' "$preferences"
}

require_xcode_version() {
  [[ -n ${XCODE_VERSION:-} ]] || die 'XCODE_VERSION is required for Xcode operations'
  is_numeric_version "$XCODE_VERSION" || die "Invalid Xcode version: $XCODE_VERSION"
}

remote_ref() {
  local variant=$1
  local tag=$2
  [[ -n "$registry" ]] || die "REGISTRY is required for registry operations"
  case "$variant" in
    vanilla|base)
      [[ "$tag" == latest || "$tag" == "$MACOS_VERSION" ]] ||
        die "$variant images use the configured macOS version or latest"
      ;;
    xcode)
      if [[ "$tag" == *-xcode* ]]; then
        [[ "$tag" == "$MACOS_VERSION"-xcode* ]] || die 'Xcode tag does not match the configured macOS version'
        is_xcode_tag "${tag#*-xcode}" || die "Invalid Xcode tag: $tag"
      else
        [[ "$tag" == latest ]] || is_xcode_tag "$tag" || die "Invalid Xcode tag: $tag"
      fi
      ;;
    *) die "Unknown image variant: $variant" ;;
  esac
  printf '%s/macos-%s-%s:%s\n' "$registry" "$MACOS_FAMILY" "$variant" "$tag"
}

select_xcode_tag() {
  local requested=$1
  local infer_version=$2
  local allow_latest=$3
  local numeric_prefix
  selected_xcode_tag=${requested:-${XCODE_TAG:-${XCODE_VERSION:-}}}
  [[ -n "$selected_xcode_tag" ]] || die 'XCODE_VERSION or XCODE_TAG is required for Xcode registry operations'
  selected_image_tag=$selected_xcode_tag
  if [[ "$selected_xcode_tag" == *-xcode* ]]; then
    [[ "$selected_xcode_tag" == "$MACOS_VERSION"-xcode* ]] || die 'Xcode tag does not match the configured macOS version'
    selected_xcode_tag=${selected_xcode_tag#*-xcode}
  fi
  if [[ "$selected_xcode_tag" == latest ]]; then
    [[ "$allow_latest" == true ]] || die 'Xcode pushes require a versioned tag'
    require_xcode_version
    return 0
  fi
  is_xcode_tag "$selected_xcode_tag" || die "Invalid Xcode tag: $selected_xcode_tag"
  if [[ -z ${XCODE_VERSION:-} ]]; then
    [[ "$infer_version" == true ]] || die 'XCODE_VERSION is required to verify an Xcode image'
    is_numeric_version "$selected_xcode_tag" ||
      die 'XCODE_VERSION is required when an Xcode tag is not a numeric version'
    XCODE_VERSION=$selected_xcode_tag
    [[ "$XCODE_VERSION" == *.* ]] || XCODE_VERSION+=.0
  fi
  require_xcode_version
  numeric_prefix=${selected_xcode_tag%%-*}
  versions_match "$numeric_prefix" "$XCODE_VERSION" ||
    die 'The Xcode tag version must match XCODE_VERSION'
  if [[ -z "$requested" || "$allow_latest" == false ]]; then
    selected_image_tag="$MACOS_VERSION-xcode$selected_xcode_tag"
  fi
}

local_vm_for_variant() {
  case "$1" in
    vanilla) printf '%s\n' "$VANILLA_VM" ;;
    base) printf '%s\n' "$BASE_VM" ;;
    xcode)
      require_xcode_version
      printf 'macos-%s-%s-xcode-%s\n' "$MACOS_FAMILY" "$MACOS_VERSION" "$XCODE_VERSION"
      ;;
    *) die "Unknown image variant: $1" ;;
  esac
}

registry_command() {
  local variant=$1
  shift
  [[ -x "$registry_helper" ]] || die "Registry helper not found or not executable: $registry_helper"
  run_bounded "$registry_timeout_seconds" env \
    IMAGE_CONFIG="$config_path" \
    IMAGE_PRERELEASE="$IMAGE_PRERELEASE" \
    MACOS_VERSION="$MACOS_VERSION" \
    MACOS_BUILD="$MACOS_BUILD" \
    MACOS_FAMILY="$MACOS_FAMILY" \
    IMAGE_VARIANT="$variant" \
    XCODE_VERSION="${XCODE_VERSION:-}" \
    XCODE_TAG="${selected_xcode_tag:-}" \
    IMAGE_REVISION="${IMAGE_REVISION:-}" \
    "$registry_helper" "$@"
}

registry_pull() {
  local variant=$1
  local reference=$2
  local target=$3
  require_new_vm "$target"
  registry_command "$variant" pull "$reference" "$target"
}

default_source() {
  local variant=$1
  if [[ "$variant" == vanilla ]] && vm_exists "$VANILLA_VM"; then
    printf '%s\n' "$VANILLA_VM"
  elif [[ "$variant" == vanilla && -z ${VANILLA_SOURCE_PROFILE:-} ]] && vm_exists "$LOCAL_VANILLA_SOURCE"; then
    printf '%s\n' "$LOCAL_VANILLA_SOURCE"
  elif [[ "$variant" == base ]] && vm_exists "$BASE_VM"; then
    printf '%s\n' "$BASE_VM"
  else
    remote_ref "$variant" "$MACOS_VERSION"
  fi
}

import_vanilla() {
  local source=${1:-$LOCAL_VANILLA_SOURCE}
  local target=${2:-$VANILLA_VM}
  require_compatible_host
  vm_exists "$source" || die "VM not found: $source"
  clone_vm "$source" "$target" vanilla
  clear_stale_control_socket "$target"
  packer_build templates/verify.pkr.hcl \
    -var "vm_name=$target" \
    -var profile=vanilla \
    -var "expected_build=$MACOS_BUILD" \
    -var "expected_version=$MACOS_VERSION" \
    -var "guest_username=$guest_username" \
    -var "guest_password=$guest_password"
}

packer_build() {
  local template=$1
  shift
  require_installed_packer_plugin
  run_bounded "$packer_build_timeout_seconds" packer build "$@" "$root_dir/$template"
}

fetch_ipsw() {
  local filename=${IPSW_URL%%\?*}
  filename=${filename##*/}
  if [[ -n "$ipsw_path_override" ]]; then
    fetched_ipsw_path=$ipsw_path_override
  else
    fetched_ipsw_path="$ipsw_cache_dir/$filename"
  fi
  mkdir -p "$(dirname "$fetched_ipsw_path")"
  require_ca_file
  ensure_artifact_helper
  run_bounded "$ipsw_fetch_timeout_seconds" "$artifact_helper" fetch \
    --timeout "$ipsw_fetch_timeout_seconds" \
    --url "$IPSW_URL" \
    --output "$fetched_ipsw_path" \
    --sha256 "$IPSW_SHA256" \
    --size "$IPSW_SIZE" \
    --ca-file "$image_cacert"
}

run_setup_phase() {
  local vm=$1
  local sequence=$2
  local initial_wait=$3
  [[ -n "$sequence" ]] || return 0
  clear_stale_control_socket "$vm"
  printf 'Running Setup Assistant sequence: %s\n' "$sequence"
  CFFIXED_USER_HOME="$temporary_locale_home" TART_HOME="${TART_HOME:-$HOME/.tart}" \
    GUEST_USERNAME="$guest_username" GUEST_PASSWORD="$guest_password" \
    run_bounded "$setup_assistant_timeout_seconds" go run ./cmd/setup-assistant \
      --vm "$vm" \
      --sequence "$sequence" \
      --initial-wait "$initial_wait" \
      --key-interval "$setup_assistant_key_interval"
}

complete_post_upgrade_setup() {
  local vm=$1
  local display
  need go
  require_duration "$setup_assistant_upgrade_wait"
  require_duration "$setup_assistant_upgrade_key_interval"
  if [[ -n ${POST_UPGRADE_SETUP_SEQUENCE:-} ]]; then
    need jq
    display=$(jq -er '
      [.width, .height] |
      select(all(.[]; type == "number" and . == floor and . > 0 and . <= 65535)) |
      "\(.[0])x\(.[1])px"
    ' "$POST_UPGRADE_SETUP_SEQUENCE") || die "Invalid post-upgrade display dimensions: $POST_UPGRADE_SETUP_SEQUENCE"
    run_bounded "$tart_operation_timeout_seconds" tart set "$vm" \
      --display "$display" --no-display-refit
  fi
  clear_stale_control_socket "$vm"
  printf 'Checking post-upgrade Setup Assistant: %s\n' "$vm"
  GUEST_USERNAME="$guest_username" GUEST_PASSWORD="$guest_password" \
    EXPECTED_VERSION="$MACOS_VERSION" EXPECTED_BUILD="$MACOS_BUILD" \
    run_bounded "$setup_assistant_timeout_seconds" go run ./cmd/setup-assistant \
      --vm "$vm" \
      --sequence "${POST_UPGRADE_SETUP_SEQUENCE:-}" \
      --post-upgrade \
      --post-upgrade-check "${POST_UPGRADE_SETUP_CHECK:-}" \
      --initial-wait "$setup_assistant_upgrade_wait" \
      --key-interval "$setup_assistant_upgrade_key_interval"
}

clean_desktop() {
  local vm=$1
  local variant=${2:-vanilla}
  local notification_sequence='' display
  local packer_build_timeout_seconds=900
  case "$variant" in
    vanilla) ;;
    base) notification_sequence=${BASE_NOTIFICATION_SEQUENCE:-} ;;
    xcode) notification_sequence=${XCODE_NOTIFICATION_SEQUENCE:-} ;;
    *) die "Invalid desktop cleanup variant: $variant" ;;
  esac
  clear_stale_control_socket "$vm"
  if [[ -n "$notification_sequence" ]]; then
    need go
    need jq
    display=$(jq -er '
      [.width, .height] |
      select(all(.[]; type == "number" and . == floor and . > 0 and . <= 65535)) |
      "\(.[0])x\(.[1])px"
    ' "$notification_sequence") || die "Invalid notification display dimensions: $notification_sequence"
    run_bounded "$tart_operation_timeout_seconds" tart set "$vm" \
      --display "$display" --no-display-refit
    printf 'Running notification cleanup sequence: %s\n' "$notification_sequence"
    GUEST_USERNAME="$guest_username" GUEST_PASSWORD="$guest_password" \
      run_bounded 480 go run ./cmd/setup-assistant \
        --vm "$vm" \
        --sequence "$notification_sequence" \
        --initial-wait 90s \
        --key-interval 300ms \
        --shutdown
    clear_stale_control_socket "$vm"
  fi
  printf 'Cleaning desktop: %s\n' "$vm"
  packer_build templates/clean-desktop.pkr.hcl \
    -var "vm_name=$vm" \
    -var "guest_username=$guest_username" \
    -var "guest_password=$guest_password"
}

build_vanilla() {
  local initial_wait=${1:-$setup_assistant_initial_wait}
  local target=${2:-$VANILLA_VM}
  local fetched_ipsw_path
  require_build_host
  require_new_vm "$target"
  if [[ -n ${VANILLA_SOURCE_PROFILE:-} ]]; then
    [[ -z ${1:-} ]] || die 'Initial Setup Assistant wait does not apply to an upgrade'
    build_upgraded_vanilla "$target"
    return
  fi
  if [[ -n ${SETUP_ASSISTANT_SEQUENCE:-} || -n ${GUEST_PROVISIONING_TEMPLATE:-} ]]; then
    need go
    need plutil
    require_duration "$create_grace_time"
    require_duration "$initial_wait"
    require_duration "$setup_assistant_key_interval"
    if [[ -n ${SETUP_ASSISTANT_RESUME_SEQUENCE:-} ]]; then
      require_duration "$setup_assistant_resume_wait"
    fi
    if [[ -n ${SETUP_ASSISTANT_USER_SEQUENCE:-} ]]; then
      require_duration "$setup_assistant_user_wait"
    fi
    if [[ -n ${SETUP_ASSISTANT_FINAL_SEQUENCE:-} ]]; then
      require_duration "$setup_assistant_final_wait"
    fi
    if [[ -n ${SETUP_ASSISTANT_GATEKEEPER_SEQUENCE:-} ]]; then
      require_duration "$setup_assistant_gatekeeper_wait"
    fi
  fi
  fetch_ipsw
  if [[ -n ${SETUP_ASSISTANT_SEQUENCE:-} || -n ${GUEST_PROVISIONING_TEMPLATE:-} ]]; then
    create_locale_home
    local tart_home=${TART_HOME:-$HOME/.tart}
    run_bounded "$tart_create_timeout_seconds" env \
      CFFIXED_USER_HOME="$temporary_locale_home" TART_HOME="$tart_home" \
      tart create "$target" --from-ipsw "$fetched_ipsw_path" --disk-size "$build_disk_size_gb"
    printf 'Waiting %s for installation finalization\n' "$create_grace_time"
    sleep "$create_grace_time"
    run_bounded "$tart_operation_timeout_seconds" tart set "$target" \
      --cpu "$CPU_COUNT" \
      --memory "$((MEMORY_GB * 1024))" \
      --display 1024x768 \
      --no-display-refit
    if [[ -n ${GUEST_PROVISIONING_TEMPLATE:-} ]]; then
      CFFIXED_USER_HOME="$temporary_locale_home" TART_HOME="$tart_home" \
        packer_build "$GUEST_PROVISIONING_TEMPLATE" \
          -var "vm_name=$target" \
          -var "expected_version=$MACOS_VERSION" \
          -var "expected_build=$MACOS_BUILD" \
          -var "guest_username=$guest_username" \
          -var "guest_password=$guest_password"
    fi
    run_setup_phase "$target" "${SETUP_ASSISTANT_SEQUENCE:-}" "$initial_wait"
    run_setup_phase "$target" "${SETUP_ASSISTANT_RESUME_SEQUENCE:-}" "$setup_assistant_resume_wait"
    run_setup_phase "$target" "${SETUP_ASSISTANT_USER_SEQUENCE:-}" "$setup_assistant_user_wait"
    run_setup_phase "$target" "${SETUP_ASSISTANT_FINAL_SEQUENCE:-}" "$setup_assistant_final_wait"
    run_setup_phase "$target" "${SETUP_ASSISTANT_GATEKEEPER_SEQUENCE:-}" "$setup_assistant_gatekeeper_wait"
    clear_stale_control_socket "$target"
    packer_build "$VANILLA_TEMPLATE" \
      -var "vm_name=$target" \
      -var "expected_version=$MACOS_VERSION" \
      -var "expected_build=$MACOS_BUILD" \
      -var "guest_username=$guest_username" \
      -var "guest_password=$guest_password"
  else
    packer_build "$VANILLA_TEMPLATE" \
      -var "vm_name=$target" \
      -var "ipsw_url=$fetched_ipsw_path" \
      -var "expected_version=$MACOS_VERSION" \
      -var "expected_build=$MACOS_BUILD" \
      -var "cpu_count=$CPU_COUNT" \
      -var "memory_gb=$MEMORY_GB" \
      -var "disk_size_gb=$build_disk_size_gb" \
      -var "guest_username=$guest_username" \
      -var "guest_password=$guest_password"
  fi
  clean_desktop "$target"
  shrink_vm "$target"
}

load_upgrade_source() {
  local source_config="$root_dir/config/$VANILLA_SOURCE_PROFILE.env"
  local source_family
  [[ -f "$source_config" && ! -L "$source_config" ]] || die 'Source profile is missing'
  (source "$source_config" && test "$IMAGE_PRERELEASE" = false && test -n "${IPSW_SHA256:-}") ||
    die 'The source must be an official IPSW profile'
  upgrade_source_config=$source_config
  upgrade_source_version=$(source "$source_config"; printf '%s' "$MACOS_VERSION")
  upgrade_source_build=$(source "$source_config"; printf '%s' "$MACOS_BUILD")
  source_family=$(source "$source_config"; printf '%s' "$MACOS_FAMILY")
  [[ "$source_family" == "$MACOS_FAMILY" && ${upgrade_source_version%%.*} == "${MACOS_VERSION%%.*}" ]] ||
    die 'An upgrade must stay within its source macOS major'
  [[ "$upgrade_source_version" != "$MACOS_VERSION" ]] && version_is_at_least "$MACOS_VERSION" "$upgrade_source_version" ||
    die 'The target must be newer than its source'
}

clone_upgrade_source() {
  local target=$1
  load_upgrade_source
  if [[ -n ${VANILLA_SOURCE_VM:-} ]]; then
    clone_vm "$VANILLA_SOURCE_VM" "$target" vanilla
  else
    [[ -n "$registry" ]] || die 'REGISTRY is required to download the pinned source image'
    MACOS_VERSION="$upgrade_source_version" MACOS_BUILD="$upgrade_source_build" config_path="$upgrade_source_config" \
      registry_pull vanilla "$registry/macos-$MACOS_FAMILY-vanilla@$VANILLA_SOURCE_DIGEST" "$target"
  fi
}

upgrade_macos() {
  local target=$1
  local installer_app
  local installer_path=${INSTALLER_PATH:-$installer_cache_dir/$INSTALLER_SHA256.pkg}
  load_upgrade_source
  case "$MACOS_FAMILY" in
    sequoia) installer_app='/Applications/Install macOS Sequoia.app' ;;
    *) die "No verified upgrade procedure for $MACOS_FAMILY" ;;
  esac

  mkdir -p "$(dirname "$installer_path")"
  require_ca_file
  ensure_artifact_helper
  run_bounded "$ipsw_fetch_timeout_seconds" "$artifact_helper" fetch \
    --timeout "$ipsw_fetch_timeout_seconds" \
    --url "$INSTALLER_URL" --output "$installer_path" \
    --sha256 "$INSTALLER_SHA256" --size "$INSTALLER_SIZE" --ca-file "$image_cacert"

  clear_stale_control_socket "$target"
  packer_build "$VANILLA_TEMPLATE" \
    -var "vm_name=$target" \
    -var "source_version=$upgrade_source_version" \
    -var "source_build=$upgrade_source_build" \
    -var "expected_version=$MACOS_VERSION" \
    -var "expected_build=$MACOS_BUILD" \
    -var "installer_archive=$installer_path" \
    -var "installer_app=$installer_app" \
    -var "disk_size_gb=$build_disk_size_gb" \
    -var "guest_username=$guest_username" \
    -var "guest_password=$guest_password"
  complete_post_upgrade_setup "$target"
}

build_upgraded_vanilla() {
  local target=$1
  clone_upgrade_source "$target"
  upgrade_macos "$target"
  clean_desktop "$target"
  shrink_vm "$target"
  verify_existing "$target" vanilla
}

build_base() {
  local source=${1:-$(default_source vanilla)}
  local target=${2:-$BASE_VM}
  prepare_base "$source" "$target"
  clean_desktop "$target" base
  shrink_vm "$target"
}

prepare_base() {
  local source=$1
  local target=$2
  require_build_host
  clone_vm "$source" "$target" vanilla
  disable_sip "$target"
  if [[ -n ${VANILLA_SOURCE_PROFILE:-} ]]; then
    upgrade_macos "$target"
    clean_desktop "$target"
  fi
  provision_base "$target"
}

disable_sip() {
  local target=$1
  vm_exists "$target" || die "VM not found: $target"
  clear_stale_control_socket "$target"
  packer_build templates/prepare-recovery.pkr.hcl \
    -var "vm_name=$target" \
    -var "guest_username=$guest_username" \
    -var "guest_password=$guest_password"
  clear_stale_control_socket "$target"
  packer_build "$DISABLE_SIP_TEMPLATE" \
    -var "vm_name=$target" \
    -var "guest_password=$guest_password"
  verify_existing "$target" sip
}

provision_base() {
  local target=$1
  require_build_host
  vm_exists "$target" || die "VM not found: $target"
  clear_stale_control_socket "$target"
  packer_build templates/base.pkr.hcl \
    -var "vm_name=$target" \
    -var "expected_version=$MACOS_VERSION" \
    -var "disk_size_gb=$build_disk_size_gb" \
    -var "guest_username=$guest_username" \
    -var "guest_password=$guest_password"
}

resolve_xcode_archive() {
  local version=${1:?Xcode version is required}
  local archive="$xcode_cache/Xcode_$version.xip"
  local silicon_archive="$xcode_cache/Xcode_${version}_Apple_silicon.xip"
  is_numeric_version "$version" || die "Invalid Xcode version: $version"
  if [[ -e "$silicon_archive" || -L "$silicon_archive" ]]; then
    archive=$silicon_archive
  fi
  [[ -f "$archive" && ! -L "$archive" && -r "$archive" && -s "$archive" ]] ||
    die "A readable, nonempty Xcode archive is required: $archive"
  printf '%s\n' "$archive"
}

grow_vm_disk() {
  local vm=$1
  local size_gb=$2
  local disk="${TART_HOME:-$HOME/.tart}/vms/$vm/disk.img"
  local current_bytes
  local maximum_bytes
  local next_size_gb
  local step
  local target_bytes=$((size_gb * 1000000000))
  [[ -f "$disk" && ! -L "$disk" ]] || die "Raw VM disk not found: $vm"
  capture_bounded 30 tart get "$vm" --format json || die "VM not found: $vm"
  jq -e '.OS == "darwin" and .State == "stopped" and .DiskFormat == "raw"' <<<"$bounded_output" >/dev/null ||
    die "VM must be stopped and use a raw macOS disk: $vm"
  wait_for_disk_close "$vm"
  for ((step = 1; step <= disk_growth_max_steps; step++)); do
    capture_bounded 60 diskutil image resize --plist "$disk" ||
      die "Could not read the disk resize limits: $vm"$'\n'"$bounded_output"
    current_bytes=$(plutil -extract current raw - <<<"$bounded_output") ||
      die "Could not read the current disk size: $vm"
    maximum_bytes=$(plutil -extract max raw - <<<"$bounded_output") ||
      die "Could not read the maximum disk size: $vm"
    [[ "$current_bytes" =~ ^[1-9][0-9]*$ && "$maximum_bytes" =~ ^[1-9][0-9]*$ ]] ||
      die "Invalid disk resize limits: $vm"
    if (( current_bytes >= target_bytes )); then
      (( current_bytes <= target_bytes + disk_size_tolerance_bytes )) ||
        die "VM disk exceeds requested build size: $vm"
      return
    fi
    if (( target_bytes <= maximum_bytes )); then
      next_size_gb=$size_gb
    else
      next_size_gb=$((maximum_bytes / 1000000000 - 1))
      (( next_size_gb * 1000000000 > current_bytes )) ||
        die "Insufficient host space to grow VM disk: $vm"
    fi
    run_bounded "$tart_operation_timeout_seconds" diskutil image resize --size "${next_size_gb}g" "$disk"
  done
  die "VM disk did not reach the requested build size: $vm"
}

provision_xcode() {
  local version=${1:?Xcode version is required}
  local target=${2:?Target VM is required}
  local archive=${3:?Xcode archive is required}
  grow_vm_disk "$target" "$build_disk_size_gb"
  packer_build templates/xcode.pkr.hcl \
    -var "vm_name=$target" \
    -var "xcode_version=$version" \
    -var "xcode_archive=$archive" \
    -var "xcode_components=${XCODE_COMPONENTS:-[]}" \
    -var "xcode_excluded_platforms=${XCODE_EXCLUDED_PLATFORMS:-[]}" \
    -var "xcode_platform_architecture=${XCODE_PLATFORM_ARCHITECTURE:-}" \
    -var "xcode_platforms=${XCODE_PLATFORMS:-[]}" \
    -var "guest_username=$guest_username" \
    -var "guest_password=$guest_password"
  if [[ ${SLIM_XCODE:-false} == true ]]; then
    packer_build templates/slim-xcode.pkr.hcl \
      -var "vm_name=$target" \
      -var "xcode_version=$version" \
      -var "xcode_excluded_platforms=${XCODE_EXCLUDED_PLATFORMS:-[]}" \
      -var "xcode_platforms=${XCODE_PLATFORMS:-[]}" \
      -var "guest_username=$guest_username" \
      -var "guest_password=$guest_password"
  fi
  clean_desktop "$target" xcode
  if [[ ${SLIM_XCODE:-false} == true ]]; then
    "$root_dir/scripts/remove-rosetta" "$target" "$MACOS_VERSION" "$MACOS_BUILD"
  fi
  shrink_vm "$target"
}

build_xcode() {
  local version=${1:?Xcode version is required}
  local source=${2:-$(default_source vanilla)}
  local target=${3:-macos-$MACOS_FAMILY-$MACOS_VERSION-xcode-$version}
  local archive
  archive=$(resolve_xcode_archive "$version")
  require_build_host
  prepare_base "$source" "$target"
  provision_xcode "$version" "$target" "$archive"
}

build_slim() {
  local variant=${1:?Image variant is required}
  local version=$2
  local source=${3:?Source VM is required}
  local target=${4:?Target VM is required}
  local archive
  [[ "$MACOS_FAMILY" != sequoia || "$variant" == xcode ]] ||
    die 'Sequoia slim images are only built for Xcode'
  case "$variant" in
    vanilla|base)
      [[ -z "$version" ]] || die "Xcode version applies only to Xcode images"
      require_build_host
      clone_vm "$source" "$target" "$variant"
      clean_desktop "$target" "$variant"
      "$root_dir/scripts/remove-rosetta" "$target" "$MACOS_VERSION" "$MACOS_BUILD"
      shrink_vm "$target"
      ;;
    xcode)
      XCODE_PLATFORMS='["iOS","watchOS"]'
      XCODE_EXCLUDED_PLATFORMS='["tvOS","visionOS"]'
      XCODE_PLATFORM_ARCHITECTURE=arm64
      SLIM_XCODE=true
      archive=$(resolve_xcode_archive "$version")
      require_build_host
      clone_vm "$source" "$target" base
      provision_xcode "$version" "$target" "$archive"
      ;;
    *) die "Unknown image variant: $variant" ;;
  esac
}

shrink_vm() {
  local vm=$1
  local disk="${TART_HOME:-$HOME/.tart}/vms/$vm/disk.img"
  local minimum_bytes
  local size_gb
  local disk_bytes
  local step_bytes=$((published_disk_step_gb * 1000000000))
  [[ "$vm" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] || die "Invalid VM name: $vm"
  [[ -f "$disk" && ! -L "$disk" ]] || die "Raw VM disk not found: $vm"
  capture_bounded 30 tart get "$vm" --format json || die "VM not found: $vm"
  jq -e '.OS == "darwin" and .State == "stopped" and .DiskFormat == "raw"' <<<"$bounded_output" >/dev/null ||
    die "VM must be stopped and use a raw macOS disk: $vm"
  wait_for_disk_close "$vm"
  capture_bounded 60 diskutil image resize --plist "$disk" ||
    die "Could not read the disk resize limits: $vm"$'\n'"$bounded_output"
  minimum_bytes=$(plutil -extract min raw - <<<"$bounded_output") ||
    die "Could not read the minimum disk size: $vm"
  [[ "$minimum_bytes" =~ ^[1-9][0-9]*$ ]] || die "Invalid minimum disk size: $minimum_bytes"
  size_gb=$(( (minimum_bytes + published_free_bytes + step_bytes - 1) / step_bytes * published_disk_step_gb ))
  disk_bytes=$(stat -f %z "$disk")
  (( size_gb * 1000000000 <= disk_bytes )) || die "Disk is too small for the required free-space reserve: $vm"
  run_bounded "$tart_operation_timeout_seconds" diskutil image resize --size "${size_gb}g" "$disk"
  printf 'Shrank %s to %s GB; minimum was %s bytes\n' "$vm" "$size_gb" "$minimum_bytes"
}

pull_image() {
  local variant=${1:?Image variant is required}
  local tag=${2:-}
  local remote
  local target
  if [[ "$variant" == xcode ]]; then
    select_xcode_tag "$tag" true true
    tag=$selected_image_tag
  else
    tag=${tag:-latest}
  fi
  remote=$(remote_ref "$variant" "$tag")
  target=$(local_vm_for_variant "$variant")
  registry_pull "$variant" "$remote" "$target"
}

push_image() {
  local variant=${1:?Image variant is required}
  local tag=${2:-}
  local vm=${3:-}
  local revision
  case "$variant" in
    vanilla)
      tag=${tag:-$MACOS_VERSION}
      [[ "$tag" == "$MACOS_VERSION" ]] || die 'Vanilla pushes require the configured macOS version tag'
      vm=${vm:-$VANILLA_VM}
      ;;
    base)
      tag=${tag:-$MACOS_VERSION}
      [[ "$tag" == "$MACOS_VERSION" ]] || die 'Base pushes require the configured macOS version tag'
      vm=${vm:-$BASE_VM}
      ;;
    xcode)
      select_xcode_tag "$tag" false false
      tag=$selected_image_tag
      [[ -n "$vm" ]] || die "A local VM name is required for Xcode images"
      ;;
    *) die "Unknown image variant: $variant" ;;
  esac
  vm_exists "$vm" || die "VM not found: $vm"
  require_registry_push_credentials "$(remote_ref "$variant" "$tag")"
  test_image "$vm" "$variant"
  revision=$(git -C "$root_dir" rev-parse HEAD 2>/dev/null || printf unknown)
  IMAGE_REVISION="$revision" registry_command "$variant" \
    push "$vm" "$(remote_ref "$variant" "$tag")"
}

resize_image() {
  local source=${1:-}
  local target=${2:-}
  local disk_size_gb=${3:-}
  local source_config
  local source_disk_gb

  [[ "$source" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] || die "Invalid source VM name: $source"
  [[ "$target" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] || die "Invalid target VM name: $target"
  [[ "$source" != "$target" ]] || die 'Source and target VM names must differ'
  [[ "$disk_size_gb" =~ ^[1-9][0-9]*$ ]] || die "Invalid disk size in GB: $disk_size_gb"
  (( ${#disk_size_gb} <= 5 )) || die 'Disk size exceeds Tart limit'
  (( disk_size_gb <= 65535 )) || die 'Disk size exceeds Tart limit'

  require_compatible_host
  need jq
  [[ -d "${TART_HOME:-$HOME/.tart}/vms/$source" && ! -L "${TART_HOME:-$HOME/.tart}/vms/$source" ]] ||
    die "Local source VM not found: $source"
  capture_bounded 30 tart get "$source" --format json || die "Local source VM not found: $source"
  source_config=$bounded_output
  [[ $(jq -r '.OS' <<<"$source_config") == darwin ]] || die 'Source must be a macOS VM'
  [[ $(jq -r '.DiskFormat' <<<"$source_config") == raw ]] || die 'Source must use a raw disk'
  [[ $(jq -r '.State' <<<"$source_config") == stopped ]] || die "Source VM must be stopped: $source"
  source_disk_gb=$(jq -r '.Disk' <<<"$source_config")
  [[ "$source_disk_gb" =~ ^[1-9][0-9]*$ ]] || die 'Could not read source disk size'
  (( disk_size_gb > source_disk_gb )) || die "Disk size must exceed source size: $source_disk_gb GB"
  require_new_vm "$target"
  [[ ! -e "${TART_HOME:-$HOME/.tart}/vms/$target" && ! -L "${TART_HOME:-$HOME/.tart}/vms/$target" ]] ||
    die "VM path already exists: $target"
  require_installed_packer_plugin

  clone_vm "$source" "$target" vanilla
  clear_stale_control_socket "$target"
  packer_build templates/resize.pkr.hcl \
    -var "vm_name=$target" \
    -var "disk_size_gb=$disk_size_gb" \
    -var "guest_username=$guest_username" \
    -var "guest_password=$guest_password"
  verify_existing "$target" vanilla
  printf 'Resized clone %s from %s to %s GB and verified an independent boot\n' \
    "$target" "$source" "$disk_size_gb"
}

verify_existing() {
  local vm=${1:?VM name is required}
  local profile=${2:?Verification profile is required}
  clear_stale_control_socket "$vm"
  packer_build templates/verify.pkr.hcl \
    -var "vm_name=$vm" \
    -var "profile=$profile" \
    -var "expected_build=$MACOS_BUILD" \
    -var "expected_version=$MACOS_VERSION" \
    -var "expected_xcode_version=${XCODE_VERSION:-}" \
    -var "guest_username=$guest_username" \
    -var "guest_password=$guest_password" \
    -var "image_flavor=${IMAGE_FLAVOR:-standard}" \
    -var "xcode_excluded_platforms=${XCODE_EXCLUDED_PLATFORMS:-[]}" \
    -var "xcode_platforms=${XCODE_PLATFORMS:-[]}"
}

wait_for_disk_close() {
  local vm=$1
  local deadline=$((SECONDS + tart_operation_timeout_seconds))
  local disk="${TART_HOME:-$HOME/.tart}/vms/$vm/disk.img"
  local status
  [[ -x /usr/sbin/lsof ]] || die 'Missing required command: /usr/sbin/lsof'
  while true; do
    status=0
    capture_bounded 20 /usr/sbin/lsof -t -- "$disk" || status=$?
    if [[ "$status" == 1 && -z "$bounded_output" ]]; then
      return 0
    fi
    [[ "$status" == 0 ]] || die "Could not confirm that the VM disk is closed: $vm"$'\n'"$bounded_output"
    (( SECONDS < deadline )) || die "VM disk remained open: $vm"
    sleep 1
  done
}

delete_test_vm() {
  local vm=$1
  vm_exists "$vm" || return 0
  run_bounded "$tart_operation_timeout_seconds" tart stop "$vm" >/dev/null 2>&1 || true
  wait_for_disk_close "$vm"
  run_bounded "$tart_operation_timeout_seconds" tart delete "$vm"
}

test_image() {
  local vm=${1:?VM name is required}
  local profile=${2:-base}
  local scratch="$vm-verify-$$"
  local result=0
  [[ "$profile" != xcode ]] || require_xcode_version
  vm_exists "$vm" || die "VM not found: $vm"
  verification_vm=$scratch
  if clone_vm "$vm" "$scratch" "$profile"; then
    if verify_existing "$scratch" "$profile"; then
      result=0
    else
      result=$?
      echo "Verification failed; deleting verification VM: $scratch" >&2
    fi
  else
    result=$?
    echo "Verification clone failed; deleting verification VM if present: $scratch" >&2
  fi
  delete_test_vm "$scratch"
  verification_vm=
  return "$result"
}

validate() {
  local template
  local script
  require_installed_packer_plugin
  for template in "$root_dir"/templates/*.pkr.hcl; do
    run_bounded "$packer_check_timeout_seconds" packer validate -syntax-only "$template"
  done
  for script in "$root_dir"/scripts/image "$root_dir"/scripts/guest/*.sh; do
    bash -n "$script"
  done
  /bin/bash "$root_dir/tests/guest-scripts.sh"
  run_bounded 1200 go test ./...
  run_bounded 600 xcrun swift format lint --recursive Package.swift Sources tests/MacOSImageCoreTests
  run_bounded 1200 env GIT_ALLOW_PROTOCOL=file xcrun swift test --disable-keychain \
    --skip-update --disable-automatic-resolution
}

doctor() {
  if [[ ${CI:-} != true && ${MACOS_IMAGE_STRICT_TOOLCHAIN:-} != true ]]; then
    verify_toolchain false
  fi
  need bash
  if [[ -n ${SETUP_ASSISTANT_SEQUENCE:-} || -n ${GUEST_PROVISIONING_TEMPLATE:-} ]]; then
    need go
  fi
  [[ $(uname -m) == arm64 ]] || die "Apple silicon is required"
  require_compatible_host
  printf 'Tart: %s\n' "$actual_tart_version"
  printf 'Packer: %s\n' "$actual_packer_version"
  if [[ -n ${SETUP_ASSISTANT_SEQUENCE:-} || -n ${GUEST_PROVISIONING_TEMPLATE:-} ]]; then
    printf 'Go: %s\n' "$actual_go_version"
    printf 'Installation grace time: %s\n' "$create_grace_time"
    if [[ -n ${GUEST_PROVISIONING_TEMPLATE:-} ]]; then
      printf 'Guest provisioning: native macOS API\n'
    fi
    printf 'Setup Assistant initial wait: %s\n' "$setup_assistant_initial_wait"
    if [[ -n ${SETUP_ASSISTANT_RESUME_SEQUENCE:-} ]]; then
      printf 'Setup Assistant resume wait: %s\n' "$setup_assistant_resume_wait"
    fi
    if [[ -n ${SETUP_ASSISTANT_USER_SEQUENCE:-} ]]; then
      printf 'Setup Assistant user wait: %s\n' "$setup_assistant_user_wait"
    fi
    if [[ -n ${SETUP_ASSISTANT_FINAL_SEQUENCE:-} ]]; then
      printf 'Setup Assistant final wait: %s\n' "$setup_assistant_final_wait"
    fi
    if [[ -n ${SETUP_ASSISTANT_GATEKEEPER_SEQUENCE:-} ]]; then
      printf 'Setup Assistant Gatekeeper wait: %s\n' "$setup_assistant_gatekeeper_wait"
    fi
  fi
  printf 'Swift: %s\n' "$actual_swift_version"
  printf 'Tart Packer plugin: %s\n' "$PACKER_TART_PLUGIN_VERSION"
  printf 'macOS: %s (%s)\n' "$MACOS_VERSION" "$MACOS_BUILD"
  if vm_exists "$LOCAL_VANILLA_SOURCE"; then
    printf 'Local vanilla source: %s\n' "$LOCAL_VANILLA_SOURCE"
  elif [[ -n "$registry" ]]; then
    printf 'Remote vanilla source: %s\n' "$(remote_ref vanilla "$MACOS_VERSION")"
  else
    printf 'No local vanilla source found; build one with macos-image build vanilla\n'
  fi
}

usage() {
  cat <<'EOF'
Usage:
  scripts/image doctor
  scripts/image validate
  scripts/image build vanilla [initial-wait] [target]
  scripts/image build base [source] [target]
  scripts/image build xcode <version> [source] [target]
  scripts/image slim <vanilla|base|xcode> [xcode-version] <source> <target>
  scripts/image import vanilla [source] [target]
  scripts/image provision base <vm>
  scripts/image provision disable-sip <vm>
  scripts/image pull <vanilla|base|xcode> [tag]
  scripts/image push <vanilla|base|xcode> [tag] [vm]
  scripts/image resize <source> <target> <disk-size-gb>
  scripts/image test <vm> [vanilla|sip|base|xcode]

Vanilla and base pushes default to the configured macOS version tag.
Vanilla and base pulls default to latest and also accept that version tag.
Xcode pushes use MACOS_VERSION-xcodeXCODE_TAG; XCODE_TAG defaults to XCODE_VERSION.
Xcode pulls also accept an Xcode version alias, or latest with XCODE_VERSION.
Set XCODE_VERSION for prerelease Xcode tags.
EOF
}

cd "$root_dir"
validate_configuration

if [[ ${CI:-} == true || ${MACOS_IMAGE_STRICT_TOOLCHAIN:-} == true ]]; then
  verify_toolchain true
fi

case ${1:-} in
  doctor) doctor ;;
  validate) validate ;;
  build)
    case ${2:-} in
      vanilla) build_vanilla "${3:-}" "${4:-}" ;;
      base) build_base "${3:-}" "${4:-}" ;;
      xcode) build_xcode "${3:-}" "${4:-}" "${5:-}" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  slim) build_slim "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
  import)
    [[ ${2:-} == vanilla ]] || { usage; exit 1; }
    import_vanilla "${3:-}" "${4:-}"
    ;;
  provision)
    case ${2:-} in
      base)
        provision_base "${3:?VM name is required}"
        clean_desktop "$3" base
        shrink_vm "$3"
        ;;
      disable-sip) disable_sip "${3:?VM name is required}" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  pull) pull_image "${2:-}" "${3:-}" ;;
  push) push_image "${2:-}" "${3:-}" "${4:-}" ;;
  resize) resize_image "${2:-}" "${3:-}" "${4:-}" ;;
  test) test_image "${2:-}" "${3:-}" ;;
  *) usage; exit 1 ;;
esac
