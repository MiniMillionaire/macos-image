#!/usr/bin/env bash
set -euo pipefail

vm=${1:?VM name is required}
expected_version=${2:?macOS version is required}
expected_build=${3:?macOS build is required}
tart_home=${TART_HOME:-$HOME/.tart}
disk="$tart_home/vms/$vm/disk.img"

[[ "$vm" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]]
[[ -f "$disk" && ! -L "$disk" ]]
if /usr/sbin/lsof -t -- "$disk" | grep -q .; then
  echo "VM disk is open: $vm" >&2
  exit 1
fi

preboot_mountpoint=
preboot=
data=
data_mountpoint=
whole=
cleanup() {
  [[ -z "$data" ]] || /usr/sbin/diskutil unmount "$data" >/dev/null 2>&1 || true
  [[ -z "$preboot" ]] || /usr/sbin/diskutil unmount "$preboot" >/dev/null 2>&1 || true
  [[ -z "$whole" ]] || /usr/sbin/diskutil eject "$whole" >/dev/null 2>&1 || true
  [[ -z "$data_mountpoint" || ! -d "$data_mountpoint" ]] || rmdir "$data_mountpoint" 2>/dev/null || true
  [[ -z "$preboot_mountpoint" || ! -d "$preboot_mountpoint" ]] || rmdir "$preboot_mountpoint" 2>/dev/null || true
}
trap cleanup EXIT

attachment=$(/usr/sbin/diskutil image attach --noMount "$disk")
whole=$(awk 'NR == 1 { print $1 }' <<< "$attachment")
[[ "$whole" =~ ^/dev/disk[0-9]+$ ]]
whole_id=${whole#/dev/}

store=$(/usr/sbin/diskutil list -plist "$whole" | python3 -c '
import plistlib
import sys

data = plistlib.loads(sys.stdin.buffer.read())
partitions = data["AllDisksAndPartitions"][0]["Partitions"]
stores = [item["DeviceIdentifier"] for item in partitions if item.get("Content") == "Apple_APFS"]
if len(stores) != 1:
    raise SystemExit("expected one main APFS store")
print(stores[0])
')
[[ "$store" == "$whole_id"* ]]

volumes=$(/usr/sbin/diskutil apfs list -plist | python3 -c '
import plistlib
import sys

store = sys.argv[1]
data = plistlib.loads(sys.stdin.buffer.read())
matches = {"Preboot": [], "Data": []}
for container in data["Containers"]:
    if store not in {item["DeviceIdentifier"] for item in container["PhysicalStores"]}:
        continue
    for volume in container["Volumes"]:
        for role in matches:
            if role in volume.get("Roles", []):
                matches[role].append(volume["DeviceIdentifier"])
for role in ("Preboot", "Data"):
    if len(matches[role]) != 1:
        raise SystemExit(f"expected one {role} volume")
    print(matches[role][0])
' "$store")
preboot=$(sed -n '1p' <<< "$volumes")
data=$(sed -n '2p' <<< "$volumes")
[[ "$preboot" =~ ^disk[0-9]+s[0-9]+$ && "$data" =~ ^disk[0-9]+s[0-9]+$ ]]

preboot_mountpoint=$(mktemp -d /tmp/macos-image-preboot.XXXXXX)
/usr/sbin/diskutil mount -mountOptions nobrowse,noowners -mountPoint "$preboot_mountpoint" "$preboot" >/dev/null
data_mountpoint=$(mktemp -d /tmp/macos-image-data.XXXXXX)
/usr/sbin/diskutil mount -mountOptions nobrowse,noowners -mountPoint "$data_mountpoint" "$data" >/dev/null

current=
while IFS= read -r plist; do
  version=$(/usr/libexec/PlistBuddy -c 'Print :ProductVersion' "$plist")
  build=$(/usr/libexec/PlistBuddy -c 'Print :ProductBuildVersion' "$plist")
  if [[ "$version" == "$expected_version" && "$build" == "$expected_build" ]]; then
    [[ -z "$current" ]] || { echo 'Multiple matching Cryptex directories' >&2; exit 1; }
    current=${plist%/SystemVersion.plist}
  fi
done < <(find "$preboot_mountpoint" -path '*/cryptex1/current/SystemVersion.plist' -type f 2>/dev/null)
[[ -n "$current" ]] || { echo 'Matching Cryptex directory not found' >&2; exit 1; }

artifacts=(
  "$current/rosetta.dmg"
  "$current/rosetta.dmg.root_hash"
  "$current/rosetta.dmg.trustcache"
)
present=0
for artifact in "${artifacts[@]}"; do
  [[ ! -e "$artifact" ]] || present=$((present + 1))
done
[[ "$present" == 0 || "$present" == "${#artifacts[@]}" ]] || {
  echo 'Incomplete Rosetta Cryptex artifact set' >&2
  exit 1
}
if (( present > 0 )); then
  rm -- "${artifacts[@]}"
fi
for artifact in "${artifacts[@]}"; do
  [[ ! -e "$artifact" ]]
done

data_artifacts=(
  "$data_mountpoint/Library/Apple/usr/lib/libRosettaAot.dylib"
  "$data_mountpoint/Library/Apple/usr/libexec/oah"
  "$data_mountpoint/Library/Apple/usr/share/rosetta"
  "$data_mountpoint/private/var/db/oah"
  "$data_mountpoint/Library/Apple/System/Library/Receipts/com.apple.pkg.RosettaUpdateAuto.bom"
  "$data_mountpoint/Library/Apple/System/Library/Receipts/com.apple.pkg.RosettaUpdateAuto.plist"
)
for artifact in "${data_artifacts[@]}"; do
  if [[ -e "$artifact" ]]; then
    [[ ! -L "$artifact" ]]
    /usr/bin/chflags -R noschg,nouchg "$artifact"
    rm -rf -- "$artifact"
  fi
done
for artifact in "${data_artifacts[@]}"; do
  [[ ! -e "$artifact" ]]
done
sync
printf 'Removed Rosetta artifacts from %s\n' "$vm"
